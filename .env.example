PORT=4000

# Collector: runs every 5 min by default, each source enforces its own poll floor.
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MS=300000

# Real sources, no key needed (already live): arbeitnow, remotive, wwr
ENABLED_SOURCES=arbeitnow,remotive,wwr
REMOTIVE_CATEGORIES=design,marketing
WWR_FEEDS=remote-design-jobs,remote-sales-and-marketing-jobs,remote-programming-jobs

# Reddit (free official OAuth, 5-min setup — see adapters/reddit.real.js)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=forhire,DesignJobs,jobbit

# Google Boolean search — public hiring posts on LinkedIn / Instagram /
# Facebook / X, found through Google's index (see adapters/google-boolean.js).
# Free tier: 100 queries/day. Create a Programmable Search Engine with
# "Search the entire web" enabled, then paste its CX + your API key.
GOOGLE_API_KEY=
GOOGLE_CX=
# Alternative: SerpAPI (paid) instead of Google CSE
SERPAPI_KEY=
# Brave Search API (free-credit path, Nov 2026): $5 of free credits/month
# (~1,000 searches). Card required on file even for free credits (identity
# check only). Adapter caps Brave at 30 queries/day — inside the free credits.
BRAVE_API_KEY=
GOOGLE_BOOLEAN_QUERIES_PER_RUN=4

# --- Legacy / optional (see README.md for how to obtain each) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_BEARER_TOKEN=
INDEED_PUBLISHER_ID=

# Refresh interval for the aggregator cache (ms)
CACHE_TTL_MS=60000
